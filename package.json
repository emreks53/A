{
  "name": "nur-u-hakikat",
  "private": true,
  "version": "1.0.0",
  "description": "Nur-u Hakikat — mobil uygulama ve web sitesi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:visual": "node scripts/compare-mockup.mjs",
    "assets:native": "capacitor-assets generate --ios --android --iconBackgroundColor '#FCC805' --iconBackgroundColorDark '#FCC805' --splashBackgroundColor '#FCC805' --splashBackgroundColorDark '#FCC805'",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "test": "vitest run",
    "test:oku": "node scripts/oku-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
